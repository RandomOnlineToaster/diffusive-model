# --- DEM download (scripts/fetch-dem.mjs) ---
OPENTOPOGRAPHY_API_KEY=replace-with-your-key
DEM_DATASET=COP30
DEM_OUTPUT_FORMAT=AAIGrid
DEM_FETCH_TIMEOUT_MS=1800000
DEM_STALL_TIMEOUT_MS=90000

# --- DEM cache grids (scripts/build-dem-cache.py) ---
# Square grid sizes. Re-run `npm run build:dem-cache` after changing these.
# Display squares on the map: one Leaflet polygon each, so keep this small.
DEM_PREVIEW_GRID=24
# Slope / flow direction / flow accumulation are computed on this grid.
# 512 over Chon Buri is roughly 200 m cells; 1024 is roughly 100 m.
DEM_ANALYSIS_GRID=512
DEM_CONTOUR_GRID=256
DEM_SAMPLE_GRID=512

# --- Browser settings (Vite exposes only VITE_* to the app) ---
# Clip map layers to the province outline. Analysis always uses the full DEM,
# because catchments cross provincial borders.
# Trim OSM river lines to the province outline.
VITE_CLIP_RIVERS=true
VITE_CLIP_TO_BOUNDARY=true
# Fill sinks/depressions before deriving flow. Off gives a broken drainage network.
VITE_FILL_SINKS=true
# Roughly how many flow arrows to draw; the analysis grid is thinned to fit.
# Analysis cells beyond the province border that flow layers may draw.
VITE_FLOW_BOUNDARY_BUFFER=2
# Flow Paths layer: how many downstream traces, and how long each may run.
VITE_FLOW_PATH_MIN_UPSTREAM=150
# Street Flow layer: minimum upstream junctions before a street is drawn.
VITE_ROAD_FLOW_MIN_UPSTREAM=25
# Fill depressions in the street graph before routing.
VITE_ROAD_FLOW_FILL_SINKS=true
# Build-time: spacing of extra points inserted along each street, in metres.
# Smaller = more detail and a bigger file. Used by npm run build:roads.
ROAD_POINT_SPACING_M=20
VITE_FLOW_PATH_STEPS=150
VITE_FLOW_PATH_ANIMATE=true
# Below this zoom the flow dashes are drawn solid: zoomed out, a chain can be
# shorter than one dash period and the animation reads as a blinking dot.
# 12 keeps dashes down to the 3 km scale bar; the blinking starts at 5 km.
VITE_FLOW_DASH_MIN_ZOOM=12
VITE_FLOW_ARROW_COUNT=350
# Cells above this percentile of flow accumulation are drawn as the drainage network.
VITE_FLOW_NETWORK_PERCENTILE=0.985

# Rain-driven flow: absolute water thresholds, so the network thins as it drains.
# Grid channels need this many m3 passing through to be drawn; streets this much
# surface water (mm summed over junctions).
# Street water physics (rain sim). Each street junction collects runoff from
# a strip of land this wide across both sides...
VITE_STREET_CATCHMENT_WIDTH_M=60
# ...of which this share actually runs off (urban ~0.9).
VITE_STREET_RUNOFF_COEFF=0.9
# Water depth is tracked in metres and moves by Manning's law down the
# WATER-SURFACE slope (ground + depth), so a flooded downstream street backs
# water up onto its neighbours. n is the street roughness (asphalt ~0.015)
# and MAX clamps the velocity in m/s.
VITE_STREET_MANNING_N=0.015
VITE_STREET_MAX_FLOW_MS=3
# Street drains/soakage remove at most this equivalent rain rate (mm/h) per
# street patch. A capacity, not a proportion: heavier input floods, and a
# standing pond clears about 1 cm every 4 minutes. Streets concentrate their
# catchment (~x7 rain), so this sits well above raw rainfall rates.
VITE_STREET_DRAIN_MM_H=150
# Kerb height (m): above it a flood spreads over the whole catchment strip
# instead of stacking on the street, so severity concentrates in low ground
# the way real floods do, not in a disc under the storm.
# Street-DEM depressions shallower than this are filled before the water model
# runs: below it a "pit" is COP30 sampling noise, and it traps a lone puddle
# that outlasts the storm. Deeper basins keep ponding, which is real.
VITE_STREET_MAX_NOISE_PIT_M=0.35
# Depressions spanning no more than this many junctions are filled whatever
# their depth: a real basin covers a stretch of streets, a 1-2 node hollow does
# not. This is what stops lone deep puddles nothing around them can explain.
VITE_STREET_MIN_BASIN_NODES=3
VITE_STREET_CURB_M=0.15
# Flood severity colour stops, metres of standing water (green..red).
# The first value is also the draw threshold: green from half a centimetre.
VITE_STREET_FLOOD_DEPTHS_M=0.005,0.05,0.15,0.30,0.50
# Couple streets to the underground pipes. Leave off until the pipe database
# has real cross-sections and invert levels.
VITE_ENABLE_PIPE_DRAIN=false
VITE_FLOW_RAIN_MIN_M3=5000
VITE_ROAD_FLOW_RAIN_MIN=300

# --- Rainfall simulator ---
# Storm grid across the DEM bounds. 400 gives ~260 m cells over Chon Buri.
VITE_RAIN_GRID_SIZE=400
# Surface-water drain time constant in simulated seconds (~10 min half-life).
VITE_RAIN_DRAIN_TAU_S=900
# Spatial variation applied after the Gaussian (0.15 = +/-15%, 0 disables).
VITE_RAIN_NOISE=0.15
# Defaults for a newly placed storm cell.
VITE_STORM_MAX_INTENSITY=100
VITE_STORM_SIGMA=1000
VITE_STORM_RAIN_RADIUS=3000
VITE_STORM_CLOUD_RADIUS=5000
