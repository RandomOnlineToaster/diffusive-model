# --- DEM download (scripts/fetch-dem.mjs) ---
OPENTOPOGRAPHY_API_KEY=replace-with-your-key
DEM_DATASET=COP30
DEM_OUTPUT_FORMAT=AAIGrid
DEM_FETCH_TIMEOUT_MS=1800000
DEM_STALL_TIMEOUT_MS=90000

# --- DEM cache grids (scripts/build-dem-cache.py) ---
# Square grid sizes. Re-run `npm run build:dem-cache` after changing these.
# Display squares on the map: one Leaflet polygon each, so keep this small.
DEM_PREVIEW_GRID=24
# Slope / flow direction / flow accumulation are computed on this grid.
# 512 over Chon Buri is roughly 200 m cells; 1024 is roughly 100 m.
DEM_ANALYSIS_GRID=512
DEM_CONTOUR_GRID=256
DEM_SAMPLE_GRID=512

# --- Browser settings (Vite exposes only VITE_* to the app) ---
# Clip map layers to the province outline. Analysis always uses the full DEM,
# because catchments cross provincial borders.
# Trim OSM river lines to the province outline.
VITE_CLIP_RIVERS=true
VITE_CLIP_TO_BOUNDARY=true
# Fill sinks/depressions before deriving flow. Off gives a broken drainage network.
VITE_FILL_SINKS=true
# Roughly how many flow arrows to draw; the analysis grid is thinned to fit.
# Analysis cells beyond the province border that flow layers may draw.
VITE_FLOW_BOUNDARY_BUFFER=2
# Flow Paths layer: how many downstream traces, and how long each may run.
VITE_FLOW_PATH_MIN_UPSTREAM=150
# Street Flow layer: minimum upstream junctions before a street is drawn.
VITE_ROAD_FLOW_MIN_UPSTREAM=25
# Fill depressions in the street graph before routing.
VITE_ROAD_FLOW_FILL_SINKS=true
# Build-time: spacing of extra points inserted along each street, in metres.
# Smaller = more detail and a bigger file. Used by npm run build:roads.
ROAD_POINT_SPACING_M=20
VITE_FLOW_PATH_STEPS=150
VITE_FLOW_PATH_ANIMATE=true
VITE_FLOW_ARROW_COUNT=350
# Classic (Shift + tick) rendering: below this zoom the marching dashes are
# drawn solid, because zoomed out they blink instead of showing direction.
VITE_FLOW_DASH_MIN_ZOOM=12

# Shift + drag on the forecast timeline marks a span of the forecast that plays
# onto the map when released, at this many forecast hours per real second with
# the simulator's speed slider at its default 10x; the slider scales it from
# there, more steeply than one for one at the slow end.
VITE_FORECAST_PLAY_HOURS_PER_S=4
# Flow Direction as drifting particles with fading trails (wind-map style).
# false draws the static arrows instead; reduced-motion settings also do.
VITE_FLOW_PARTICLES=true
# Particles on screen at once on a large viewport; small ones get fewer.
VITE_FLOW_PARTICLE_COUNT=2500
# Cells above this percentile of flow accumulation are drawn as the drainage network.
VITE_FLOW_NETWORK_PERCENTILE=0.985

# Rain-driven flow: absolute water thresholds, so the network thins as it drains.
# Grid channels need this many m3 passing through to be drawn; streets this much
# surface water (mm summed over junctions).
# Street water physics (rain sim). Each street junction collects runoff from
# a strip of land this wide across both sides...
VITE_STREET_CATCHMENT_WIDTH_M=60
# ...of which this share actually runs off (urban ~0.9).
VITE_STREET_RUNOFF_COEFF=0.9
# Water depth is tracked in metres and moves by Manning's law down the
# WATER-SURFACE slope (ground + depth), so a flooded downstream street backs
# water up onto its neighbours. n is the street roughness (asphalt ~0.015)
# and MAX clamps the velocity in m/s.
VITE_STREET_MANNING_N=0.015
VITE_STREET_MAX_FLOW_MS=3
# OUTSIDE the surveyed drain network only: street drains/soakage remove at
# most this equivalent rain rate (mm/h) per street patch. Inside it the
# inlets and pipes (see the drainage physics section) take over. A capacity, not a proportion: heavier input floods, and a
# standing pond clears about 1 cm every 4 minutes. Streets concentrate their
# catchment (~x7 rain), so this sits well above raw rainfall rates.
VITE_STREET_DRAIN_MM_H=150
# Kerb height (m): above it a flood spreads over the whole catchment strip
# instead of stacking on the street, so severity concentrates in low ground
# the way real floods do, not in a disc under the storm.
# Street-DEM depressions shallower than this are filled before the water model
# runs: below it a "pit" is COP30 sampling noise, and it traps a lone puddle
# that outlasts the storm. Deeper basins keep ponding, which is real.
VITE_STREET_MAX_NOISE_PIT_M=0.35
# Depressions spanning no more than this many junctions are filled whatever
# their depth: a real basin covers a stretch of streets, a 1-2 node hollow does
# not. This is what stops lone deep puddles nothing around them can explain.
VITE_STREET_MIN_BASIN_NODES=3
VITE_STREET_CURB_M=0.15
# Flood severity colour stops, metres of standing water (green..red).
# The first value is also the draw threshold: green from half a centimetre.
VITE_STREET_FLOOD_DEPTHS_M=0.005,0.05,0.15,0.30,0.50
# The drainage physics (pipes, inlets, tide, wind, ensemble) is configured
# in its own section at the end of this file.
VITE_FLOW_RAIN_MIN_M3=5000

# --- Live weather layers (Weather card) ---
# JAXA GSMaP infrared cloud-top tiles, clipped to the study area. Keyless.
# The product is hourly and lands a few hours behind real time; this is how far
# back to look for the newest frame that exists.
VITE_GSMAP_LATENCY_H=5
VITE_CLOUD_OPACITY=0.65
# CARTO basemap API key for the grey "Light" base. Without it CARTO watermarks
# its keyless tiles, so the map falls back to Esri's keyless Light Gray Canvas.
# A basemap key is client-side (restrict it by allowed domain at carto.com);
# put the real one in .env.local, not here.
VITE_CARTO_KEY=
# Thai Meteorological Department province forecast. TMD's CORS policy allows
# only its own site, so requests go through the vite proxy at this path.
VITE_TMD_PROXY_PATH=/tmd
# TMD's published demo credentials; register at https://data.tmd.go.th/ for
# your own. The high-resolution grid forecast (nwpapi, 2 km hourly) needs an
# OAuth token instead and is not wired up yet.
# TMD's high-resolution grid forecast (nwpapi) needs an OAuth token from
# https://data.tmd.go.th/. With one, the forecast layer draws TMD's own grid;
# without it, the keyless Open-Meteo fallback is used instead.
VITE_TMD_TOKEN=
# 2 = hourly, 72 h, ~3 km.  1 = 3-hourly, 10 days, ~9 km.
VITE_TMD_DOMAIN=2
# Fallback grid: sample points per side across the study bounds, days ahead,
# and how solid the cells are drawn.
# 20 x 20 samples over the 3x area is a cell of ~0.15 degrees (16 km) - close
# to the model's own ~11 km. 10 makes 35 km cells: the whole of Pattaya in
# one figure. The simulation interpolates between cells either way, so a
# coarse grid smears rather than cuts, but it cannot invent detail.
VITE_FORECAST_GRID=20
# Days ahead for the keyless fallback. 16 is the provider maximum, but a
# rain forecast past about ten days carries little real skill.
VITE_FORECAST_DAYS=7
VITE_FORECAST_OPACITY=0.5
# Ceiling on drawn cells. TMD at 3 km over the whole province returns far
# more than this, so points are thinned evenly to keep the map responsive;
# narrow VITE_TMD_DOMAIN to 1, or the study bounds, for full resolution.
VITE_FORECAST_MAX_CELLS=1500
VITE_TMD_UID=api
VITE_TMD_UKEY=api12345

# --- Rainfall simulator ---
# Storm grid across the DEM bounds. 400 gives ~260 m cells over Chon Buri.
VITE_RAIN_GRID_SIZE=400
# Surface-water drain time constant in simulated seconds (~10 min half-life).
VITE_RAIN_DRAIN_TAU_S=900
# Spatial variation applied after the Gaussian (0.15 = +/-15%, 0 disables).
VITE_RAIN_NOISE=0.15
# Defaults for a newly placed storm cell.
VITE_STORM_MAX_INTENSITY=100
VITE_STORM_SIGMA=1000
VITE_STORM_RAIN_RADIUS=3000
VITE_STORM_CLOUD_RADIUS=5000

# --- drainage physics (src/pipeNetwork.js, src/roadFlow.js) ---
# Run the surveyed drain network under the streets. Needs
# public/data/drainage-model.json from `npm run build:drainage`; without it
# the streets fall back to VITE_STREET_DRAIN_MM_H everywhere.
VITE_ENABLE_DRAINAGE_MODEL=true
# Upper clamp on the water speed inside a pipe, m/s.
VITE_PIPE_MAX_FLOW_MS=4
# Flap valves on the sea outfalls keep the tide out of the pipes. Pattaya's
# outfalls are open, so by default the sea comes in at high water.
VITE_OUTFALL_FLAP_VALVE=false
# Pump stations: the survey names them but records no capacity. Every station
# runs at this rate (m3/s) once its sump is START deep, until it is STOP deep.
VITE_PUMP_RATED_M3S=1.0
VITE_PUMP_START_DEPTH_M=0.5
VITE_PUMP_STOP_DEPTH_M=0.1
# Share of every grated inlet blocked by litter and silt (0 = clean grates).
VITE_INLET_CLOGGING=0.5
# Street junctions within this distance of a surveyed drain junction drain
# only through inlets; beyond it the generic drain term applies.
VITE_DRAIN_COVERAGE_RADIUS_M=150
# A dead end of the street graph at or below this height (m) meets the sea
# and drains against the tide; higher ones discharge freely off the map.
VITE_SEA_OUTFALL_MAX_ELEV_M=1.5

# Infiltration: Horton's curve, mm/h at first (F0) and once saturated (FC),
# decaying at K per hour. 60 -> 12 at 2/h is a sandy loam; clay ~25 -> 3.
VITE_INFILTRATION_F0_MM_H=60
VITE_INFILTRATION_FC_MM_H=12
VITE_INFILTRATION_K_PER_H=2
# The pervious share of a street patch (cracks, verges) and of the catchment
# strip a flood spreads onto past the kerb (yards, gardens).
VITE_PERVIOUS_STREET=0.05
VITE_PERVIOUS_STRIP=0.35

# --- sea level (src/tide.js) ---
# auto = Open-Meteo Marine sea-level forecast (tide + surge, keyless), with a
# synthetic harmonic tide when it cannot be fetched; harmonic = always the
# synthetic tide; manual = a fixed level of VITE_TIDE_MANUAL_M metres MSL.
VITE_TIDE_MODE=auto
VITE_TIDE_MANUAL_M=0
# Starting position of the panel's surge slider: metres on top of the source.
VITE_TIDE_SURGE_M=0

# --- wind (src/wind.js) ---
# A newly placed storm drifts with the forecast steering wind (its sliders
# still override it). It moves at STEERING_FACTOR x the 850 hPa wind, or,
# when no wind aloft is available, at that factor x SURFACE_FACTOR x the 10 m
# wind.
VITE_STORM_FOLLOWS_WIND=true
VITE_STORM_STEERING_FACTOR=0.75
VITE_STORM_STEERING_SURFACE_FACTOR=1.5

# --- ensemble (src/ensemble.js) ---
# "Run ensemble" replays the placed storms MEMBERS times over HOURS of sim
# time in STEP_S steps, jittering each storm's track (m), speed and bearing,
# intensity and size by these one-sigma amounts, and paints the share of
# runs in which each street flooded deeper than THRESHOLD_M.
VITE_ENSEMBLE_MEMBERS=8
VITE_ENSEMBLE_HOURS=3
VITE_ENSEMBLE_STEP_S=300
VITE_ENSEMBLE_THRESHOLD_M=0.05
VITE_ENSEMBLE_TRACK_SIGMA_M=1500
VITE_ENSEMBLE_SPEED_SIGMA=0.3
VITE_ENSEMBLE_BEARING_SIGMA_DEG=25
VITE_ENSEMBLE_INTENSITY_SIGMA=0.3
VITE_ENSEMBLE_SIZE_SIGMA=0.2
